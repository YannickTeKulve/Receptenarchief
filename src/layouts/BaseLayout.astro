---
import { serializeJsonLd } from '../lib/jsonld';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title = 'Yannicks Kookboek',
  description = 'Een persoonlijk receptenarchief met beproefde recepten.',
  image,
  jsonLd,
} = Astro.props;
const pageTitle = title === 'Yannicks Kookboek' ? title : `${title} — Yannicks Kookboek`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const base = import.meta.env.BASE_URL;
const serializedJsonLd = jsonLd ? serializeJsonLd(jsonLd) : undefined;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#edf0e9" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content="Yannicks Kookboek" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <title>{pageTitle}</title>
    {serializedJsonLd && <script is:inline type="application/ld+json" set:html={serializedJsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#inhoud">Naar inhoud</a>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
