---
interface Props { total: number; }
const { total } = Astro.props;
---

<section class="archive-controls" aria-label="Recepten doorzoeken en tonen">
  <label class="search-field">
    <span class="visually-hidden">Zoek in recepten</span>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
    <input id="recipe-search" type="search" placeholder="Zoek op recept, keuken of ingrediënt" autocomplete="off" />
  </label>
  <label class="time-filter">
    <span>Tijd</span>
    <select id="time-filter">
      <option value="">Alle</option>
      <option value="30">≤ 30 min</option>
      <option value="45">≤ 45 min</option>
      <option value="60">≤ 60 min</option>
    </select>
  </label>
  <div class="view-switch" aria-label="Weergave">
    <button type="button" data-view="list" aria-pressed="true">Lijst</button>
    <button type="button" data-view="grid" aria-pressed="false">Raster</button>
  </div>
</section>
<div class="archive-status" aria-live="polite"><span id="visible-count">{total}</span> recepten</div>
