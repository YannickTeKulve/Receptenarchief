---
interface Props {
  eyebrow?: string;
  compact?: boolean;
}
const { eyebrow = 'Persoonlijk receptenarchief', compact = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<header class:list={['site-masthead', { 'site-masthead--compact': compact }]}>
  <a class="site-wordmark" href={base} aria-label="Yannicks Kookboek, naar receptenarchief">
    <span>{eyebrow}</span>
    <strong>Yannicks<br />Kookboek</strong>
  </a>
</header>
