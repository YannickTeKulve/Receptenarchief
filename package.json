{
  "name": "receptenarchief",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "BASE_PATH=/ SITE_URL=http://127.0.0.1:4173 astro build && playwright test",
    "sync:recipes": "node scripts/sync-recipes.mjs",
    "sync:recipes:check": "node scripts/sync-recipes.mjs --check",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.2",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
